# ==========================================
# Rust & Cargo Build Artifacts
# ==========================================
target/
**/target/
/target-build/
**/__pycache__/
*.pyc
**/*.rs.bk
*.pdb
Cargo.lock.bak
*.WebView2/
node_modules/
**/dist/

# ==========================================
# AetherScope Runtime Transient Bridge
# (Generated dynamically at runtime: audit reports, live targets, personal paths)
# ==========================================
/.aether/*
crates/**/.aether/*
!/.aether/.gitkeep
!/.aether/plugins/
!/.aether/plugins/**

# ==========================================
# Release Archives & Binaries
# ==========================================
/releases/
*.exe
*.dll
*.so
*.dylib

# ==========================================
# Logs, Dumps & Temp Files
# ==========================================
*.log
*.txt
!requirements.txt
*.tmp
*.bak
*.swp
*.patch
instances/**/world/
.aether_pending_deliveries.json

# ==========================================
# Python Cache
# ==========================================
__pycache__/
*.py[cod]
*$py.class

# ==========================================
# IDE & System Files
# ==========================================
.vscode/
.idea/
.agents/
crates/**/AETHER_AI_RULES.md
*.sublime-project
*.sublime-workspace
.DS_Store
Thumbs.db
desktop.ini
